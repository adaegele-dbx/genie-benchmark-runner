    }, 'benchmarks': {'questions': [
            {'id': '01f106b52cbe1ac697d61faa882a22c2', 'question': ['How many completed runs did we have last month?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT COUNT(*) AS delivery_count\n', 'FROM zg.genie_demo.delivery_runs\n',
                            "WHERE status = 'delivered'\n",
                            "  AND scheduled_at >= add_months(DATE_TRUNC('month', CURRENT_DATE), -1)\n",
                            "  AND scheduled_at < DATE_TRUNC('month', CURRENT_DATE);"
                        ]
                    }
                ]
            },
            {'id': '01f106b52467157e887537f9eea70521', 'question': ['What percentage of deliveries were on time last quarter?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT ROUND(try_divide(100.0 * SUM(CASE WHEN delivered_at <= scheduled_at + INTERVAL 2 HOURS THEN 1 ELSE 0 END), COUNT(*)),
                            2) AS on_time_rate_pct\n', 'FROM zg.genie_demo.delivery_runs\n',
                            "WHERE status = 'delivered'\n",
                            "  AND scheduled_at >= add_months(DATE_TRUNC('quarter', CURRENT_DATE), -3)\n",
                            "  AND scheduled_at < DATE_TRUNC('quarter', CURRENT_DATE);"
                        ]
                    }
                ]
            },
            {'id': '01f106b51c8718bba6c05fd28733d531', 'question': ['How many deliveries were completed per depot last month?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT d.depot_name, COUNT(*) AS delivery_count\n', 'FROM zg.genie_demo.delivery_runs r\n', 'JOIN zg.genie_demo.depots d ON r.depot_id = d.depot_id\n',
                            "WHERE r.status = 'delivered'\n",
                            "  AND r.scheduled_at >= add_months(DATE_TRUNC('month', CURRENT_DATE), -1)\n",
                            "  AND r.scheduled_at < DATE_TRUNC('month', CURRENT_DATE)\n", 'GROUP BY d.depot_id, d.depot_name;'
                        ]
                    }
                ]
            },
            {'id': '01f106b513081932b2d6a748abdd5ee6', 'question': ['What is the average cost per delivery by vehicle type?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT v.vehicle_type, ROUND(AVG(r.cost_usd),
                            2) AS avg_cost_usd\n', 'FROM zg.genie_demo.delivery_runs r\n', 'JOIN zg.genie_demo.vehicles v ON r.vehicle_id = v.vehicle_id\n',
                            "WHERE r.status = 'delivered'\n", 'GROUP BY v.vehicle_type;'
                        ]
                    }
                ]
            },
            {'id': '01f106b509d51b9fa0d4dd04026bb78d', 'question': ['What was total revenue by region this year?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT r.region_name, SUM(dr.revenue_usd) AS total_revenue\n', 'FROM zg.genie_demo.delivery_runs dr\n', 'JOIN zg.genie_demo.depots d ON dr.depot_id = d.depot_id\n', 'JOIN zg.genie_demo.regions r ON d.region_id = r.region_id\n',
                            "WHERE dr.status = 'delivered'\n",
                            "  AND dr.scheduled_at >= DATE_TRUNC('year', CURRENT_DATE)\n", 'GROUP BY r.region_id, r.region_name;'
                        ]
                    }
                ]
            },
            {'id': '01f106b501c113d8a700b3cebfdc69e2', 'question': ['Which depot had the highest delivery volume last quarter?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT dep.depot_name, COUNT(*) AS delivery_count\n', 'FROM zg.genie_demo.delivery_runs r\n', 'JOIN zg.genie_demo.depots dep ON r.depot_id = dep.depot_id\n',
                            "WHERE r.status = 'delivered'\n",
                            "  AND r.scheduled_at >= add_months(DATE_TRUNC('quarter', CURRENT_DATE), -3)\n",
                            "  AND r.scheduled_at < DATE_TRUNC('quarter', CURRENT_DATE)\n", 'GROUP BY dep.depot_id, dep.depot_name\n', 'ORDER BY delivery_count DESC\n', 'LIMIT 1;'
                        ]
                    }
                ]
            },
            {'id': '01f106b4f8711679983bdfd5d9e58134', 'question': ['Which depot had the highest delivery volume in the South region?'
                ], 'answer': [
                    {'format': 'SQL', 'content': ['SELECT\n', '  dep.depot_name,\n', '  COUNT(*) AS delivery_count\n', 'FROM\n', '  zg.genie_demo.delivery_runs dr\n', '    JOIN zg.genie_demo.depots dep\n', '      ON dr.depot_id = dep.depot_id\n', '    JOIN zg.genie_demo.regions reg\n', '      ON dep.region_id = reg.region_id\n', 'WHERE\n',
                            "  dr.status = 'delivered'\n",
                            "  AND reg.region_name = 'South'\n", 'GROUP BY\n', '  dep.depot_name\n', 'ORDER BY\n', '  delivery_count DESC\n', 'LIMIT 1;'
                        ]
                    }
                ]
            },
